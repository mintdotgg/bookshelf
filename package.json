{
  "name": "side-one-vinyl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "dev:app": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:local": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "library:server": "node --env-file-if-exists=.env.local services/local-library/server.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node --env-file-if-exists=.env.local scripts/dev-local.mjs start",
    "start:app": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs && npm run test:local-library && npm run check:mint",
    "test:local-library": "node --experimental-strip-types --test services/local-library/*.test.mjs",
    "check:mint": "node scripts/check-mint-tooling.mjs && node --test .agents/skills/mint-threejs-skills/scripts/sync-mint-assets.test.mjs",
    "generate:previews": "node --experimental-strip-types scripts/generate-record-previews.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/three": "^0.185.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
